@echo off
REM Generated by install-background-service.ps1 - do not edit by hand; re-run the
REM installer to regenerate. This is Windows' equivalent of MAC's
REM `KeepAlive = { SuccessfulExit = false }` LaunchAgent decision
REM (Phase 1 completion report §4.3): `schtasks`'s AtLogOn trigger starts this
REM wrapper exactly once per logon, and this loop is what supplies the
REM "a deliberate stop stays stopped; a crash is respawned" behaviour that
REM launchd gives macOS for free and Windows Task Scheduler does not.
setlocal
set RUNTIME_DATA_DIR=__RUNTIME_DATA_DIR__
set DAEMON_EXE=__DAEMON_EXE__

:loop
"%DAEMON_EXE%"
set EXITCODE=%ERRORLEVEL%
if "%EXITCODE%"=="0" (
    REM Clean exit - `runtime.stop`'s coordinator-driven shutdown, or a
    REM graceful Ctrl+C - honoured as a deliberate stop. Do NOT restart.
    exit /b 0
)
REM Non-zero exit - a crash. Wait briefly, then restart, mirroring
REM launchd's KeepAlive-on-crash-only semantics.
timeout /t 3 /nobreak >nul
goto loop
