<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AI_Native_Runtime_Windows.Views.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:AI_Native_Runtime_Windows.Shared"
    xmlns:models="using:AI_Native_Runtime_Windows.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <shared:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Padding="24" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Showing the 100 most recent executions." Opacity="0.6" />

        <Grid Grid.Row="1">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Width="32" Height="32" />

            <InfoBar Severity="Error" IsOpen="{x:Bind ViewModel.IsError, Mode=OneWay}"
                     Title="Could not load activity" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     VerticalAlignment="Top">
                <InfoBar.ActionButton>
                    <Button Content="Retry" Command="{x:Bind ViewModel.RetryCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <TextBlock Text="No executions yet." Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            <ListView ItemsSource="{x:Bind ViewModel.Executions}"
                      Visibility="{x:Bind ViewModel.IsData, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                      SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ExecutionItem">
                        <StackPanel Padding="0,6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind CapabilityId}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind State}" Opacity="0.7" />
                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="4,0"
                                        Visibility="{x:Bind IsCloudDispatched, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="cloud-dispatched" FontSize="11" Foreground="White" />
                                </Border>
                            </StackPanel>
                            <TextBlock Opacity="0.6" FontSize="12" Text="{x:Bind CreatedAt}" />
                            <TextBlock Opacity="0.6" FontSize="12"
                                       Visibility="{x:Bind HasCorrelationId, Converter={StaticResource BoolToVisibility}}"
                                       Text="{x:Bind CorrelationId}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
