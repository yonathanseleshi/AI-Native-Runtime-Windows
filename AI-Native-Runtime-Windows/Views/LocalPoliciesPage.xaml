<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AI_Native_Runtime_Windows.Views.LocalPoliciesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:AI_Native_Runtime_Windows.Shared"
    xmlns:models="using:AI_Native_Runtime_Windows.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="LocalPoliciesPageRoot">

    <Page.Resources>
        <shared:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ProgressRing Grid.Row="0"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                      HorizontalAlignment="Center" Width="32" Height="32" />

        <InfoBar Grid.Row="0" Severity="Error" IsOpen="{x:Bind ViewModel.IsError, Mode=OneWay}"
                 Title="Could not load local policies" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}">
            <InfoBar.ActionButton>
                <Button Content="Retry" Command="{x:Bind ViewModel.RetryCommand}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!--
            Plan §4.8: sync_status must be genuinely visible on this desktop
            surface, not merely stored - shown prominently at the top,
            regardless of loading/data/empty state.
        -->
        <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="2"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
            <TextBlock Text="{x:Bind ViewModel.SyncState.DisplayLabel, Mode=OneWay}" FontWeight="SemiBold" />
            <TextBlock Text="{x:Bind ViewModel.SyncState.SyncedAt, Mode=OneWay}" Opacity="0.6" FontSize="12" />
            <TextBlock Text="{x:Bind ViewModel.SyncState.LastError, Mode=OneWay}" Foreground="Red" FontSize="12" />
        </StackPanel>

        <!-- Create form - no delete action anywhere in this page (§4.7). -->
        <StackPanel Grid.Row="2" Orientation="Vertical" Spacing="8">
            <TextBlock Text="New local policy" FontWeight="SemiBold" />
            <InfoBar Severity="Error" IsOpen="{x:Bind ViewModel.HasActionError, Mode=OneWay}"
                     Message="{x:Bind ViewModel.ActionErrorMessage, Mode=OneWay}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox PlaceholderText="capabilityKey (optional)" Width="180" Text="{x:Bind ViewModel.NewConditionCapabilityKey, Mode=TwoWay}" />
                <TextBox PlaceholderText="runtimeApplicationId (optional)" Width="180" Text="{x:Bind ViewModel.NewConditionApplicationId, Mode=TwoWay}" />
                <TextBox PlaceholderText="runtimeDeviceId (optional)" Width="180" Text="{x:Bind ViewModel.NewConditionDeviceId, Mode=TwoWay}" />
                <ComboBox SelectedItem="{x:Bind ViewModel.NewEffect, Mode=TwoWay}" Width="160">
                    <x:String>DENY</x:String>
                    <x:String>REQUIRE_APPROVAL</x:String>
                </ComboBox>
                <NumberBox Value="{x:Bind ViewModel.NewPriority, Mode=TwoWay}" Minimum="1" Maximum="1000" Width="100" SpinButtonPlacementMode="Compact" />
                <Button Content="Create" Command="{x:Bind ViewModel.CreateCommand}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Text="No local policies exist on this device yet."
                   Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" />

        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Policies}"
                  Visibility="{x:Bind ViewModel.IsData, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:LocalPolicyItem">
                    <Grid Padding="0,8" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    AutomationProperties.Name="{x:Bind AccessibilitySummary}">
                            <TextBlock FontWeight="SemiBold" AutomationProperties.AccessibilityView="Raw">
                                <Run Text="{x:Bind Effect}" />
                                <Run Text=" (" />
                                <Run Text="{x:Bind StatusLabel}" />
                                <Run Text=") - priority " />
                                <Run Text="{x:Bind Priority}" />
                            </TextBlock>
                            <TextBlock Opacity="0.7" FontSize="12" AutomationProperties.AccessibilityView="Raw"
                                       Text="{x:Bind ConditionsSummary}" />
                            <TextBlock Opacity="0.5" FontSize="12" AutomationProperties.AccessibilityView="Raw">
                                <Run Text="Updated by " />
                                <Run Text="{x:Bind UpdatedBy}" />
                                <Run Text=" at " />
                                <Run Text="{x:Bind UpdatedAt}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <!--
                                No delete button here, deliberately (plan §4.7, a hard
                                constraint) - retirement is disabling, never removal.
                            -->
                            <Button Content="{x:Bind ToggleActionLabel}"
                                    Command="{Binding ViewModel.ToggleEnabledCommand, ElementName=LocalPoliciesPageRoot}"
                                    CommandParameter="{x:Bind}"
                                    AutomationProperties.Name="{x:Bind ToggleAutomationLabel}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
