<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AI_Native_Runtime_Windows.Views.SignInPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AI_Native_Runtime_Windows.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            MaxWidth="360"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16">

            <TextBlock
                Text="AI Native Runtime"
                Style="{StaticResource TitleTextBlockStyle}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="Sign in to register this device"
                Style="{StaticResource BodyTextBlockStyle}"
                Opacity="0.7"
                HorizontalAlignment="Center"
                Margin="0,0,0,8" />

            <!-- Email/password only: SUBAPI has no Google/social sign-in wired up, so there is deliberately no alternate sign-in button here. -->
            <TextBox
                x:Name="EmailBox"
                Header="Email"
                PlaceholderText="you@example.com"
                InputScope="EmailNameOrAddress" />

            <PasswordBox
                x:Name="PasswordBox"
                Header="Password" />

            <Button
                x:Name="SignInButton"
                Content="Sign In"
                HorizontalAlignment="Stretch"
                Style="{StaticResource AccentButtonStyle}"
                Click="OnSignInClick" />

            <ProgressRing
                x:Name="BusyRing"
                IsActive="False"
                Visibility="Collapsed"
                Width="24"
                Height="24"
                HorizontalAlignment="Center" />

            <!--
                The three genuinely distinguishable failure states named in
                the application guide. Each is its own InfoBar with its own
                Severity/title/message and its own retry affordance, rather
                than one generic "something went wrong" banner - a user who
                sees "Runtime unavailable" should reach for a different fix
                (start the Core) than one who sees "Substrate offline"
                (check network) or "Registration rejected" (check org
                membership / contact an admin).
            -->
            <InfoBar
                x:Name="RuntimeUnavailableBanner"
                Title="Runtime unavailable"
                Message="AI Native Runtime Core is not reachable on this machine. Make sure the Core service is installed and running, then try again."
                Severity="Error"
                IsOpen="False"
                IsClosable="False">
                <InfoBar.ActionButton>
                    <Button Content="Retry" Click="OnRetryClick" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar
                x:Name="SubstrateOfflineBanner"
                Title="Substrate offline"
                Message="Could not reach the sign-in service or the AI Native Substrate right now. Check your network connection and try again."
                Severity="Warning"
                IsOpen="False"
                IsClosable="False">
                <InfoBar.ActionButton>
                    <Button Content="Retry" Click="OnRetryClick" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar
                x:Name="RegistrationRejectedBanner"
                Title="Registration rejected"
                Message="This device could not be registered to your organization. Confirm you have access to AI Native Runtime with this account, or contact an administrator."
                Severity="Error"
                IsOpen="False"
                IsClosable="False" />

            <InfoBar
                x:Name="SignInFailedBanner"
                Title="Sign-in failed"
                Message="Incorrect email or password."
                Severity="Error"
                IsOpen="False"
                IsClosable="True" />

        </StackPanel>
    </Grid>
</Page>
