<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AI_Native_Runtime_Windows.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <StackPanel Spacing="16" MaxWidth="480">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Spacing="4">
                <TextBlock Text="Background service" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.BackgroundServiceStatus, Mode=OneWay}" TextWrapping="Wrap" />
                <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshBackgroundServiceStatusCommand}" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Account" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Button Content="Sign Out" Click="OnSignOutClick" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
