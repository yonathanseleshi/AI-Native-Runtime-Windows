<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AI_Native_Runtime_Windows.Views.PermissionGrantsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:AI_Native_Runtime_Windows.Shared"
    xmlns:models="using:AI_Native_Runtime_Windows.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="PermissionGrantsPageRoot">

    <Page.Resources>
        <shared:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Padding="24">
        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Width="32" Height="32" />

        <InfoBar Severity="Error" IsOpen="{x:Bind ViewModel.IsError, Mode=OneWay}"
                 Title="Could not load permission grants" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 VerticalAlignment="Top">
            <InfoBar.ActionButton>
                <Button Content="Retry" Command="{x:Bind ViewModel.RetryCommand}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <TextBlock Text="No permission grants exist for this application yet."
                   Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" />

        <ListView ItemsSource="{x:Bind ViewModel.Grants}"
                  Visibility="{x:Bind ViewModel.IsData, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:PermissionGrantItem">
                    <Grid Padding="0,8" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    AutomationProperties.Name="{x:Bind AccessibilitySummary}">
                            <TextBlock FontWeight="SemiBold" AutomationProperties.AccessibilityView="Raw">
                                <Run Text="{x:Bind CapabilityId}" />
                                <Run Text=" - " />
                                <Run Text="{x:Bind Effect}" />
                                <Run Text=" (" />
                                <Run Text="{x:Bind Status}" />
                                <Run Text=")" />
                            </TextBlock>
                            <TextBlock Opacity="0.7" FontSize="12" AutomationProperties.AccessibilityView="Raw">
                                <Run Text="Application " />
                                <Run Text="{x:Bind ApplicationId}" />
                                <Run Text=" - scope " />
                                <Run Text="{x:Bind ScopeSummary}" />
                                <Run Text=" - duration " />
                                <Run Text="{x:Bind Duration}" />
                            </TextBlock>
                            <TextBlock Opacity="0.5" FontSize="12" AutomationProperties.AccessibilityView="Raw">
                                <Run Text="Granted by " />
                                <Run Text="{x:Bind GrantedBy}" />
                                <Run Text=" at " />
                                <Run Text="{x:Bind GrantedAt}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="Revoke"
                                    Visibility="{x:Bind CanRevoke, Converter={StaticResource BoolToVisibility}}"
                                    Command="{Binding ViewModel.RevokeCommand, ElementName=PermissionGrantsPageRoot}"
                                    CommandParameter="{x:Bind}"
                                    AutomationProperties.Name="{x:Bind RevokeAutomationLabel}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
